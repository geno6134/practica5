def calculate_tax(year_income: float):
    """Рассчитывает подоходный налог и выводит финансовый отчет.

    Принимает на вход годовой доход пользователя, вычисляет сумму
    налога и остаток средств после налогообложения. Результаты
    выводятся в консоль с форматированием до двух знаков после запятой
    и разделителями тысяч.
    year_income(float): Годовой доход пользователя в рублях.
    """
    TAX_RATE = 0.13
    tax_amount = year_income * TAX_RATE
    tax_income = year_income - tax_amount

    print(f"Общая сумма дохода: {year_income:,.2f}".replace(",", " ") + " руб.")
    print(f"Сумма налога: {tax_amount:,.2f}".replace(",", " ") + " руб.")
    print(f"Сумма после вычета налога: {tax_income:,.2f}".replace(",", " ") + " руб.")


try:
    user_income = float(input("Введите ваш годовой доход (только число): "))
    calculate_tax(user_income)
except ValueError:
    print("Ошибка: пожалуйста, введите корректное число.")
