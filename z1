TAX_RATE = 0.13

user_income = float(input("Введите ваш годовой доход: "))

tax_amount = user_income * TAX_RATE
net_income = user_income - tax_amount
print(f"Общая сумма дохода: {user_income:,.2f}".replace(",", " ")+ " руб.")
print(f"Сумма налога: {tax_amount:,.2f}".replace(",", " ")+ " руб.")
print(f"Сумма после вычета налога: {net_income:,.2f}".replace(",", " ")+ " руб." )
