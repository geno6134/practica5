def calculate_banknotes(amount: int):
    """Рассчитывает минимальное количество купюр для выдачи заданной суммы.

    Реализует "жадный" алгоритм: последовательно проверяет номиналы
    от самых крупных к самым мелким, вычисляет необходимое количество
    купюр каждого номинала и уменьшает оставшуюся сумму. Результат
    выводится в консоль.

    Args:
        amount (int): Запрашиваемая сумма для снятия (кратная 100).
    """
    BANKNOTES = [5000, 2000, 1000, 500, 200, 100]

    print(f"Отчет о выдаче суммы {amount} руб.:")
    remaining_amount = amount
    for note in BANKNOTES:
        count = remaining_amount // note
        if count > 0:
            print(f"Купюры номиналом {note} руб.: {count} шт.")
        remaining_amount %= note

user_amount = int(input("Введите сумму для снятия (кратная 100): "))
calculate_banknotes(user_amount)
